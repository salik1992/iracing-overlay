{
  "name": "@salik1992/iracing-overlay-server",
  "version": "0.0.0",
  "private": true,
  "author": "Vit Salomon (salik1992)",
  "description": "Reads iRacing telemetry and streams overlay frames to local browser widgets.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --import tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "irsdk-node": "^4.4.0",
    "tsx": "^4.20.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
